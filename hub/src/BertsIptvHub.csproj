<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Version comes from hub/VERSION (single source of truth for exe, installer and status page).
       CI passes -p:BuildNumber=<run number>. -->
  <PropertyGroup>
    <HubVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</HubVersion>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Version>$(HubVersion)</Version>
    <AssemblyVersion>$(HubVersion).0</AssemblyVersion>
    <FileVersion>$(HubVersion).$(BuildNumber)</FileVersion>
    <InformationalVersion>$(HubVersion)+build.$(BuildNumber)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Bert's IPTV Hub</Product>
    <Company>Bert's Apps</Company>
    <Description>Shares one IPTV (Xtream) connection with every TV in the house</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BertsIptvHub</AssemblyName>
    <RootNamespace>BertsIptvHub</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ApplicationIcon>../installer/assets/hub.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Windows service support. Build with -p:NoWinService=true for a plain console build (testing). -->
  <PropertyGroup Condition="'$(NoWinService)' != 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS_SERVICE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(NoWinService)' != 'true'">
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="../installer/assets/logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="../installer/assets/hub.ico" LogicalName="favicon.ico" />
  </ItemGroup>

</Project>
