{
  "Hub": {
    "ListenUrl": "http://0.0.0.0:8090",

    "Provider": {
      "Url": "http://your-provider-host:8080",
      "Username": "YOUR_XTREAM_USERNAME",
      "Password": "YOUR_XTREAM_PASSWORD",
      "UserAgent": "okhttp/4.12.0",
      "LiveExtension": "ts"
    },

    "LocalUsername": "home",
    "LocalPassword": "changeme",

    "JoinBufferKB": 4096,
    "IdleTimeoutSeconds": 20,
    "UpstreamRetries": 5,
    "UpstreamStallSeconds": 15,
    "SubscriberQueueChunks": 1024,

    "UpdateCheckMinutes": 30,
    "CatalogCacheHours": 6,
    "EpgCacheHours": 12,
    "ShortEpgCacheMinutes": 10,

    "ExtraEpgEnabled": true,
    "ExtraEpgSources": [
      "https://epgshare01.online/epgshare01/epg_ripper_UK1.xml.gz",
      "https://epgshare01.online/epgshare01/epg_ripper_ZA1.xml.gz"
    ],

    "DataDir": "data"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
